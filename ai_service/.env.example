# ===== CẤU HÌNH TRỢ LÝ AI NALI =====
# Sao chép file này thành ".env" rồi điền giá trị thật.
#   cp .env.example .env   (Windows: copy .env.example .env)

# --- Chọn "bộ não" AI: auto | local | gemini | offline ---
#   auto  = ưu tiên LLM tự host (local) -> Gemini -> offline
#   local = model mở tự host (Qwen2.5-3B finetune) -> KHUYÊN DÙNG cho đồ án
LLM_BACKEND=auto

# --- LLM TỰ HOST (Qwen2.5-3B finetune, qua Ollama/llama.cpp, chuẩn OpenAI) ---
# Ollama mặc định: http://localhost:11434/v1 ; trong Docker: http://ollama:11434/v1
LOCAL_LLM_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=nali-dental          # tên model đã nạp vào Ollama (xem finetune/)
LOCAL_LLM_KEY=ollama                 # Ollama không cần key thật

# --- Gemini API (bộ não dự phòng khi không có LLM tự host) ---
# Lấy key MIỄN PHÍ tại: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- Kết nối Database (khớp với config.php của web PHP) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=nali_dental

# --- Cấu hình phòng khám (dùng cho kiểm tra lịch trống) ---
CLINIC_OPEN_HOUR=8      # Giờ mở cửa
CLINIC_CLOSE_HOUR=20    # Giờ đóng cửa
SLOT_MINUTES=60         # Mỗi khung giờ hẹn dài bao nhiêu phút

# --- Server ---
HOST=127.0.0.1
PORT=8000

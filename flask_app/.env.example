# ===== Cấu hình Flask NALI (sao chép thành .env) =====
SECRET_KEY=doi-chuoi-bi-mat-nay

# Database (dùng chung MySQL nali_dental với bản PHP)
DB_USER=root
DB_PASS=replace-with-your-current-mysql-password
DB_HOST=localhost
DB_PORT=3306
DB_NAME=nali_dental
# Local: Flask sẽ tạo các bảng chưa có khi khởi động. Production đặt 0 và chạy init-db/migration trước deploy.
AUTO_CREATE_SCHEMA=1

# AI service (chatbot LLM finetune)
AI_SERVICE_URL=http://127.0.0.1:8000

# Email (Flask-Mail) - để trống sẽ KHÔNG gửi thật (in console), app vẫn chạy.
# Với Gmail: bật 2FA rồi tạo "App password" 16 ký tự.
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=NALI Dental <no-reply@nali.local>

PER_PAGE=6

# Đặt cọc giữ chỗ qua VietQR (0đ). Để trống BANK_ACCOUNT_NO -> ẩn tính năng cọc.
BANK_ID=MB
BANK_ACCOUNT_NO=
BANK_ACCOUNT_NAME=NALI DENTAL CLINIC
DEPOSIT_AMOUNT=100000
# Token cho cron nhắc lịch (GitHub Actions)
CRON_TOKEN=

# Google Analytics 4 + Search Console (trống = tắt)
GA_MEASUREMENT_ID=
GOOGLE_SITE_VERIFICATION=

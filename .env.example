# Sao chép thành .env ở thư mục gốc khi deploy bằng Docker (docker-compose.prod.yml). Không commit .env.
# Chạy local không Docker thì dùng flask_app/.env.example và ai_service/.env.example.
DOMAIN=your-domain.example
MYSQL_ROOT_PASSWORD=replace-with-a-long-random-password
DB_NAME=nali_dental
SECRET_KEY=replace-with-a-long-random-secret
AI_SERVICE_URL=https://your-ai-service.example
# Email (Gmail App Password) — để trống thì web không gửi mail
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=NALI Dental <no-reply@example.com>

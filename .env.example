# Sao chép file này thành .env trên máy/deploy server. Không commit file .env.
APP_ENV=development
DB_NAME=nali_dental
# Dùng cùng mật khẩu với MYSQL_ROOT_PASSWORD khi Flask/PHP cùng truy cập MySQL Docker.
# Không dùng 123456 trên máy chủ thật.
DB_PASS=replace-with-your-current-mysql-password
# Tạo chuỗi dài, ngẫu nhiên; production không được dùng giá trị mẫu này.
MYSQL_ROOT_PASSWORD=replace-with-a-long-random-password
SECRET_KEY=replace-with-a-long-random-secret
INITIAL_ADMIN_PASSWORD=replace-with-a-unique-admin-password
INITIAL_STAFF_PASSWORD=replace-with-separate-staff-password
# Chỉ cần khi dùng Gemini thay vì Ollama local.
GEMINI_API_KEY=
# Reminder e-mail: only enable when the server can send e-mail correctly.
MAIL_ENABLED=0
MAIL_FROM=no-reply@example.com
REMINDER_CRON_TOKEN=replace-with-a-long-random-token
GA4_MEASUREMENT_ID=G-XXXXXXXXXX
# Deploy Flask production (Gunicorn + Nginx + Let's Encrypt)
DOMAIN=your-domain.example
AI_SERVICE_URL=https://your-ai-service.example
